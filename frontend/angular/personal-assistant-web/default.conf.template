server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        # min-replicas:0 cold starts (API container start + possible SQL serverless
        # auto-resume) can take longer than nginx's ~60s default; keep this comfortably
        # above the 45s client-side timeout in auth.service.ts so the Angular "waking up"
        # message always wins the race, not a bare nginx 502/504. Also covers the credit
        # card statement pipeline (Document Intelligence OCR + Claude Haiku classification,
        # both run synchronously in-request — see credit-card.service.ts's own 150s timeout),
        # which can legitimately take well over a minute for a multi-page statement.
        proxy_connect_timeout 75s;
        proxy_read_timeout 180s;
        # Azure Container Apps' shared environment ingress routes TLS by SNI; nginx omits
        # the SNI extension by default when proxying to an https upstream, so the ingress
        # resets the handshake without this.
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
